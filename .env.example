# =========================
# App
# =========================
PORT=3000
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
DEFAULT_CLINIC_ID=
ADMIN_API_KEY=change-this-admin-key

# =========================
# MongoDB
# =========================
MONGODB_URI=mongodb://127.0.0.1:27017/whatsapp_ai_bot

# =========================
# OpenAI
# =========================
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# =========================
# WhatsApp Cloud API
# Current Graph API version as of August 2026: v26.0
# =========================
WHATSAPP_API_VERSION=v26.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=change-this-webhook-verify-token
META_APP_SECRET=

# Approved WhatsApp template for reminders.
# Example template text:
# "Hello {{1}}, reminder: you have an appointment with {{2}} on {{3}} at {{4}}."
WHATSAPP_REMINDER_TEMPLATE_NAME=appointment_reminder
WHATSAPP_REMINDER_TEMPLATE_LANGUAGE=en_US

# Optional: alert a human support number when a ticket is created.
HUMAN_SUPPORT_NUMBER=
WHATSAPP_SUPPORT_ALERT_TEMPLATE_NAME=
WHATSAPP_SUPPORT_ALERT_TEMPLATE_LANGUAGE=en_US

# =========================
# Google Calendar
# =========================
GOOGLE_CALENDAR_ENABLED=true
GOOGLE_TIMEZONE=Africa/Nairobi
# Base64-encoded Google service-account JSON.
# Share each doctor's Google Calendar with the service account email
# and grant permission to make changes to events.
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=

# =========================
# Clinic defaults
# =========================
CLINIC_NAME=Demo Health Clinic
CLINIC_PHONE=+254700000000
CLINIC_ADDRESS=Nairobi, Kenya
CLINIC_WEBSITE=https://example.com
